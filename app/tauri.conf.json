{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sterling Quest Sync",
  "version": "0.1.30",
  "identifier": "com.sterlingaddons.questsync",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sterling Quest Sync Companion",
        "width": 1000,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Sterling",
    "shortDescription": "Optional companion app for the Sterling Quest Sync add-on",
    "copyright": "MIT",
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBRjNENDcyODg1Rjc3QTYKUldTbWQxK0ljdFR6R3BzSk8xTCt1eVU2SXRTbzZLR0hqeTlhT0tZWnVNTW1uWUYreHJvVjZqdHMK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://sync.sterlingaddons.com/update/latest.json",
        "https://github.com/SterlingAddons/SterlingQuestSync-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}